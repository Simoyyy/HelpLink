rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ── users ───────────────────────────────────────────────────────────────
    // Any signed-in user can read profiles (needed for donor↔beneficiary display).
    // Users can only write their own document.
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isOwner(userId);
      allow update: if isAuth() && isOwner(userId);
      allow delete: if false;
    }

    // ── help_requests ────────────────────────────────────────────────────────
    // Any signed-in user can read (donors browse, beneficiaries view their own).
    // Only beneficiaries can create (their own).
    // Both parties can update (donor accepts/completes, beneficiary edits/cancels).
    // Only the beneficiary can delete their own pending request.
    match /help_requests/{requestId} {
      allow read:   if isAuth();

      allow create: if isAuth() &&
        request.resource.data.beneficiaryId == request.auth.uid;

      allow update: if isAuth() && (
        resource.data.beneficiaryId == request.auth.uid ||
        resource.data.donorId       == request.auth.uid ||
        request.resource.data.donorId == request.auth.uid
      );

      allow delete: if isAuth() &&
        resource.data.beneficiaryId == request.auth.uid;
    }

    // ── messages (subcollection of help_requests) ─────────────────────────────
    // Messages live at help_requests/{requestId}/messages/{messageId}.
    // Any signed-in user who knows the requestId can read; only sender can create.
    match /help_requests/{requestId}/messages/{messageId} {
      allow read, write: if isAuth();
    }

    // ── feedbacks ─────────────────────────────────────────────────────────────
    // Any signed-in user can read feedback.
    // Only the reviewer can submit their own feedback.
    // Feedback is immutable once submitted.
    match /feedbacks/{feedbackId} {
      allow read:          if isAuth();
      allow create:        if isAuth() &&
        request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
