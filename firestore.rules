rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Verification codes
    match /verification_codes/{email} {
      allow read, write: if request.auth != null;
    }

    // Help requests
    match /help_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.beneficiaryId == request.auth.uid;
      allow update: if request.auth != null
        && (request.resource.data.beneficiaryId == request.auth.uid
            || request.resource.data.donorId == request.auth.uid
            || resource.data.status == 'pending');
      allow delete: if request.auth != null
        && resource.data.beneficiaryId == request.auth.uid;
    }

    // Chat rooms
    match /chat_rooms/{chatRoomId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Allow creation (participants field doesn't exist yet)
      allow create: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
