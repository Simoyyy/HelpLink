rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images: only the owner can write their own image,
    // any authenticated user can read (needed to display avatars).
    match /profile_images/{userId}.jpg {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
